#!name=Spotify去广告
#!desc=Spotify去广告加部分解锁会员功能,音质不能设置为超高,适用于9.1.98版本及以后。
#!icon=https://img.icons8.com/?size=100&id=ZuQiaFCa1vXe&format=png&color=000000
#!date=261123

[Rule]
# AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/nebula\/v.\/configuration\/attributes header-del if-none-match
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/remote-config-resolver\/v.\/configuration header-del if-none-match

[URL Rewrite]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon - reject
#屏蔽播放界面的探索内容显示，凭个人喜好开关
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/watch-feed-entrypoints\/v.\/discovery-from-seed - reject
#屏蔽设置界面会员信息，仅改变显示，可以删去
#^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ - reject
#屏蔽AI DJ的url
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq - reject

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
search_noAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse,requires-body=1,binary-body-mode=1,max-size=204800,timeout=10,script-path=https://mirror.ghproxy.com/https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoSearchAd.js
261110_spotifyProto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|nebula\/v1\/configuration\/attributes)(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=204800,timeout=10,script-path=https://mirror.ghproxy.com/https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/261110-spot.js
scroll_noAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify,requires-body=1,binary-body-mode=1,max-size=204800,timeout=10,script-path=https://mirror.ghproxy.com/https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoScrollAd.js
remote_spotify = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/remote-config-resolver\/v.\/configuration,requires-body=1,binary-body-mode=1,max-size=204800,timeout=10,script-path=https://mirror.ghproxy.com/https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-remote.js
home_noAd = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/default,requires-body=1,binary-body-mode=1,max-size=204800,timeout=10,script-path=https://mirror.ghproxy.com/https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/spot-NoHomeAd.js
