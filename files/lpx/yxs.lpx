#!name=心悦俱乐部每日自动领取
#!desc=每日定时领取心悦俱乐部礼包：依次领取任务 381、4156，最后执行一次 batch 一键领取。需先打开一次心悦 App 的礼包页面以抓取登录凭证。接口与任务ID在脚本内的 DEFAULTS 中修改。
#!icon=https://img.icons8.com/?size=100&id=5336&format=png&color=000000
#!date=261126

[Script]
# 抓取登录凭证：打开心悦 App 时匹配到礼包接口即保存登录头（只读请求头，不解码二进制请求体）
http-request ^https:\/\/bgw\.xinyue\.qq\.com\/(xyapp\.GiftSrv\/|apisix\/xinyue\/batch) script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/yxs_qiandao.js, requires-body=false, binary-body-mode=true, timeout=10, tag=抓取xy凭证

# 每日定时领取：默认每天 08:05 执行，可自行修改 cron 表达式
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/yxs_qiandao.js, timeout=60, tag=每日自动领取

[Mitm]
hostname = bgw.xinyue.qq.com
