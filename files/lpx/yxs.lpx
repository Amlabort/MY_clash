#!name=英雄杀自动签到
#!desc=每日定时领取心悦俱乐部礼包：依次领取任务（默认 381、4156），最后执行一次 batch 一键领取。需先打开一次心悦 App 的礼包页面以抓取登录凭证。修改接口或任务后需重新导入插件。
#!icon=
#!date=261125

[Argument]
xy-receive = input,"https://bgw.xinyue.qq.com/xyapp.GiftSrv/ReceiveGift",tag=领取接口地址
xy-batch = input,"https://bgw.xinyue.qq.com/apisix/xinyue/batch",tag=一键领取接口地址
xy-tasks = input,"381|4156",tag=任务ID列表（用|分隔）
xy-batch-hex = input,"",tag=一键领取请求体（十六进制，无空格）

[Script]
http-request ^https:\/\/bgw\.xinyue\.qq\.com\/(xyapp\.GiftSrv\/|apisix\/xinyue\/batch) script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/yxs_qiandao.js, requires-body=false, binary-body-mode=true, timeout=10, tag=抓取xy凭证

cron "5 8 * * *" script-path=https://raw.githubusercontent.com/Amlabort/MY_clash/refs/heads/main/files/lpx/js/yxs_qiandao.js, argument=receive={xy-receive}&batch={xy-batch}&tasks={xy-tasks}&batchHex={xy-batch-hex}, timeout=60, tag=每日自动领取

[Mitm]
hostname = bgw.xinyue.qq.com
